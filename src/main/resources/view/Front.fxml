<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.controller.MainController">
   <children>
      <TextField fx:id="localField" layoutX="78.0" layoutY="62.0" onAction="#getDataLocalField" prefHeight="25.0" prefWidth="473.0" promptText="Digite o nome da cidade" />
      <Button fx:id="btnSearch" layoutX="279.0" layoutY="103.0" mnemonicParsing="false" onAction="#searchInformation" prefHeight="36.0" prefWidth="70.0" text="Buscar">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <TextArea fx:id="informationArea" editable="false" layoutX="9.0" layoutY="186.0" prefHeight="200.0" prefWidth="580.0" />
      <Text layoutX="121.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Sistema de informações climáticas">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Text>
   </children>
</AnchorPane>
